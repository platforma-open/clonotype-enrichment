// Import parameters for the design enrichment results (draft).
// Per end point: its score, its Max Log2FC and its Enrichment Quality. Per pairwise comparison one
// Log2FC column, kept in the column picker rather than the table, since there are many of them. As
// in classic mode the table shows the summary and hides the detail. All follow plan order, so an
// arm's columns sit together.
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")

getColumns := func(abundanceSpec, plan, blockId, enrichmentThreshold) {
	baseDomain := {
		"pl7.app/blockId": blockId,
		"pl7.app/design/designId": plan.designId,
		"pl7.app/design/comparison": plan.comparison
	}

	columns := []
	// One result column. `domainId` says what the column is about, not where it sits in the plan:
	// a comparison's two sample sets, an end point's own key. Marking an arm as a control drops its
	// score, which used to shift every later `s2` down a place and silently re-point a block that
	// had remembered one of ours. An end point's score, its Max Log2FC and its Enrichment Quality
	// share one domain and are told apart by the type.
	add := func(id, domainId, valueType, kind, label, group, priority, extra) {
		columns = append(columns, {
			column: id,
			id: id,
			allowNA: true,
			spec: {
				name: "pl7.app/enrichment",
				valueType: valueType,
				domain: maps.merge(baseDomain, {
					"pl7.app/enrichment/type": kind,
					"pl7.app/design/column": domainId
				}),
				annotations: maps.merge({
					"pl7.app/label": label,
					"pl7.app/design/group": group,
					"pl7.app/table/orderPriority": string(priority)
				}, extra)
			}
		})
	}
	asScore := {
		"pl7.app/isScore": "true",
		"pl7.app/score/rankValues": "increasing",
		"pl7.app/table/visibility": "default",
		"pl7.app/format": ".2f"
	}

	// the plan's label names the two ends and the arm they sit in; every other Double here says what
	// the number is, and the comparison column held the only figure the table did not name
	for i, c in plan.comparisons {
		add(c.id, c.key, "Double", "designComparison", "Log2FC " + c.label, c.group, 9000 - i, {
			"pl7.app/table/visibility": "optional",
			"pl7.app/format": ".2f"
		})
	}
	for i, s in plan.scores {
		group := s.group || s.arm
		cutoff := enrichmentThreshold
		if s.threshold != undefined {
			cutoff = s.threshold
		}
		add(s.id, s.end, "Double", "designScore", s.label, group, 95000 - i, maps.merge(asScore, {
			"pl7.app/score/defaultCutoff": string(cutoff)
		}))
		add(s.id + "_max", s.end, "Double", "designMax", "Max Log2FC, " + group, group, 94000 - i, asScore)
		add(s.id + "_quality", s.end, "String", "designQuality", "Enrichment Quality, " + group, group, 93000 - i, {
			"pl7.app/table/visibility": "default"
		})
	}

	return {
		axes: [
			{
				column: "elementId",
				spec: maps.deepMerge(abundanceSpec.axesSpec[1], {
					annotations: {
						"pl7.app/table/visibility": "default"
					}
				})
			}
		],
		columns: columns,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

export ll.toStrict({
	getColumns: getColumns
})
