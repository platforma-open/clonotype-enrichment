// Import parameters for the design-mode plot data (draft). Same column names as the classic
// plots (pf-stacked-conv, pf-bubble-conv, pf-control-scatter-conv), so the plot pages find them,
// with a path or score axis where a design has several.
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")

PATH_AXIS := "pl7.app/design/track"
COMPARISON_AXIS := "pl7.app/design/comparisonName"
SCORE_AXIS := "pl7.app/design/score"

stringAxis := func(column, name, label) {
	return {
		column: column,
		spec: { name: name, type: "String", domain: {}, annotations: { "pl7.app/label": label } }
	}
}

doubleColumn := func(column, id, name, label, format, extra) {
	return {
		column: column,
		id: id,
		allowNA: true,
		spec: {
			name: name,
			valueType: "Double",
			domain: {},
			annotations: maps.merge({ "pl7.app/label": label, "pl7.app/format": format }, extra)
		}
	}
}

// Line and bar plots: top clones' frequency along each path of the plan. The path axis only
// where the plan holds more than one: a single path facetted by itself is a strip with one title.
freqColumns := func(abundanceSpec, tracks) {
	axes := [
		{ column: "elementId", spec: abundanceSpec.axesSpec[1] },
		stringAxis("Condition", "pl7.app/condition", "Position")
	]
	if tracks > 1 {
		axes = append(axes, stringAxis("Track", PATH_AXIS, "Path"))
	}
	return {
		axes: axes,
		columns: [
			doubleColumn("Frequency", "frequency", "pl7.app/frequency", "Frequency", ".2e", {}),
			doubleColumn("EnrichmentVsBaseline", "enrichmentVsBaseline", "pl7.app/enrichmentVsBaseline",
				"Enrichment vs Baseline", ".2f", {})
		],
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

// Bubble plot: top clones' enrichment in every comparison of the plan. The arm is part of each
// comparison's label rather than an axis of its own: one chart holding a target arm beside its
// control says more than a dropdown that shows one arm at a time.
bubbleColumns := func(abundanceSpec) {
	return {
		axes: [
			{ column: "elementId", spec: abundanceSpec.axesSpec[1] },
			stringAxis("Comparison", COMPARISON_AXIS, "Comparison")
		],
		columns: [
			doubleColumn("Frequency_Numerator", "NumeratorFrequency", "pl7.app/numerator-frequency",
				"Numerator Frequency", ".2e", {}),
			doubleColumn("Enrichment", "enrichment", "pl7.app/enrichment", "Enrichment", ".2f", {})
		],
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

// Control scatter: every clone's target enrichment against its highest control, by score
controlColumns := func(abundanceSpec) {
	toPlot := { "pl7.app/toPlot": "true" }
	return {
		axes: [
			{ column: "elementId", spec: abundanceSpec.axesSpec[1] },
			stringAxis("Score", SCORE_AXIS, "Score")
		],
		columns: [
			doubleColumn("TargetEnrichment", "maxenrichment", "pl7.app/maxEnrichment",
				"Target Log2FC", ".2f", toPlot),
			doubleColumn("MaxNegControlEnrichment", "maxnegcontrolenrichment",
				"pl7.app/maxNegControlEnrichment", "Control max Log2FC", ".2f", toPlot),
			doubleColumn("Frequency", "frequency", "pl7.app/frequency", "Target frequency", ".2e", toPlot),
			{
				column: "BindingSpecificity",
				id: "binding_specificity",
				allowNA: true,
				spec: {
					name: "pl7.app/vdj/bindingSpecificity",
					valueType: "String",
					domain: {},
					annotations: { "pl7.app/label": "Binding Specificity", "pl7.app/toPlot": "true" }
				}
			}
		],
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

export ll.toStrict({
	PATH_AXIS: PATH_AXIS,
	SCORE_AXIS: SCORE_AXIS,
	freqColumns: freqColumns,
	bubbleColumns: bubbleColumns,
	controlColumns: controlColumns
})
